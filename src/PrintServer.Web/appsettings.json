{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PrintServer": {
    "PrinterName": "HP135a",
    "MaxUploadMb": 20,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".txt" ],
    "SpoolDir": "/var/lib/printserver/uploads",
    "UseFakeCups": false
  }
}
