[Unit]
Description=PrintServerMX9 - pagina web de impressao
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=simple
User=printserver
Group=printserver
WorkingDirectory=/opt/printserver
ExecStart=/opt/printserver/PrintServer.Web
Restart=on-failure
RestartSec=5

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:80
Environment=DOTNET_GCHeapHardLimit=0x8000000
Environment=DOTNET_NOLOGO=1

# Porta 80 sem rodar como root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Cria /var/lib/printserver (dono: printserver) para os uploads temporarios.
StateDirectory=printserver

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/printserver

[Install]
WantedBy=multi-user.target
